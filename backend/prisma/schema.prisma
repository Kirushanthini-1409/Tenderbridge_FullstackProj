generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  INTERESTED
  DRAFT
  SUBMITTED
  UNDER_EVALUATION
  RESULT_RELEASED
  CLOSED
  RECEIVED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  AWARDED
  NOT_SELECTED
  WITHDRAWN
}

enum ProcurementStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CLOSED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum VerificationType {
  BUSINESS
  ORGANIZATION
}

enum ClarificationStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum TenderFaqStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum AccountRole {
  BUSINESS
  ORGANIZATION
}

model AccountRoleAssignment {
  id          String      @id @default(uuid()) @db.Uuid
  ownerAuthId String      @unique
  role        AccountRole @default(BUSINESS)
  assignedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([role, updatedAt])
}

model Tender {
  id                  String             @id @default(uuid()) @db.Uuid
  referenceNumber     String?            @unique
  title               String
  description         String?            @db.Text
  category            String?
  issuingAuthority    String?
  status              String?
  submissionDeadline  DateTime?
  estimatedValue      Decimal?           @db.Decimal(18, 2)
  location            String?
  quantity            String?
  openingDate         DateTime?
  deliveryDuration    String?
  officialLink        String?
  eligibilityCriteria Json?
  requiredDocuments   String[]           @default([])
  extractionMetadata  Json?
  applications        Application[]
  savedBy             SavedOpportunity[]
  partnerListings     PartnerListing[]
  versions            TenderVersion[]
  faqs                TenderFaq[]
  result              TenderResult?
  extractionRuns      TenderExtraction[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([submissionDeadline])
}

model Application {
  id                  String                     @id @default(uuid()) @db.Uuid
  ownerAuthId         String
  tenderId            String                     @db.Uuid
  tender              Tender                     @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  status              ApplicationStatus          @default(INTERESTED)
  notes               String?                    @db.Text
  referenceNo         String?
  tenderVersionNumber Int?
  submissionDate      DateTime?
  submittedSnapshot   Json?
  submittedDocuments  Json?
  revisions           Json?                      @default("[]")
  statusHistory       Json?
  reviewNotes         String?                    @db.Text
  rejectionReason     String?                    @db.Text
  clarifications      ApplicationClarification[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([ownerAuthId, tenderId])
  @@index([ownerAuthId, updatedAt])
}

model ApplicationClarification {
  id               String                            @id @default(uuid()) @db.Uuid
  applicationId    String                            @db.Uuid
  application      Application                       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject          String                            @db.VarChar(180)
  status           ClarificationStatus               @default(OPEN)
  responseDeadline DateTime?
  createdByAuthId  String
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  respondedAt      DateTime?
  closedAt         DateTime?
  messages         ApplicationClarificationMessage[]

  @@index([applicationId, status, createdAt])
}

model ApplicationClarificationMessage {
  id              String                   @id @default(uuid()) @db.Uuid
  clarificationId String                   @db.Uuid
  clarification   ApplicationClarification @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  senderAuthId    String
  senderRole      String                   @db.VarChar(20)
  body            String                   @db.Text
  createdAt       DateTime                 @default(now())

  @@index([clarificationId, createdAt])
}

model SavedOpportunity {
  id          String   @id @default(uuid()) @db.Uuid
  ownerAuthId String
  tenderId    String   @db.Uuid
  tender      Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  seenVersion Int      @default(0)

  @@unique([ownerAuthId, tenderId])
  @@index([ownerAuthId, createdAt])
}

model TenderVersion {
  id              String   @id @default(uuid()) @db.Uuid
  tenderId        String   @db.Uuid
  tender          Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  versionNumber   Int
  snapshot        Json
  changedFields   Json     @default("[]")
  createdByAuthId String?
  source          String   @db.VarChar(40)
  createdAt       DateTime @default(now())

  @@unique([tenderId, versionNumber])
  @@index([tenderId, createdAt])
}

model TenderFaq {
  id               String          @id @default(uuid()) @db.Uuid
  tenderId         String          @db.Uuid
  tender           Tender          @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  question         String          @db.Text
  answer           String?         @db.Text
  status           TenderFaqStatus @default(PENDING)
  askedByAuthId    String?
  answeredByAuthId String?
  answeredAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenderId, status, createdAt])
  @@index([askedByAuthId, createdAt])
}

model TenderResult {
  id                String   @id @default(uuid()) @db.Uuid
  tenderId          String   @unique @db.Uuid
  tender            Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  summary           String   @db.Text
  publishedByAuthId String
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorAuthId String
  actorRole   String   @db.VarChar(20)
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(60)
  entityId    String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorAuthId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model PartnerListing {
  id                  String   @id @default(uuid()) @db.Uuid
  ownerAuthId         String
  tenderId            String   @db.Uuid
  tender              Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  companyName         String
  offeredCapabilities String   @db.Text
  contactPerson       String
  contactEmail        String
  contactPhone        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenderId, createdAt])
}

model SavedPartner {
  id               String          @id @default(uuid()) @db.Uuid
  ownerAuthId      String
  partnerProfileId String          @db.Uuid
  partnerProfile   BusinessProfile @relation(fields: [partnerProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@unique([ownerAuthId, partnerProfileId])
  @@index([ownerAuthId, createdAt])
}

model OrganizationProcurement {
  id                     String             @id @default(uuid()) @db.Uuid
  ownerAuthId            String
  title                  String
  category               String
  description            String             @db.Text
  estimatedValue         Decimal?           @db.Decimal(18, 2)
  location               String?
  quantity               String?
  openingDate            DateTime?
  deliveryDuration       String?
  submissionDeadline     DateTime
  minTurnover            Decimal?           @db.Decimal(18, 2)
  minExperienceYears     Int?
  requiredCertifications String[]           @default([])
  locationRestrictions   String[]           @default([])
  eligibilityCriteria    Json?
  requiredDocuments      String[]           @default([])
  pdfFileName            String?
  pdfData                Bytes?
  extractedText          String?            @db.Text
  extractionMetadata     Json?
  extractionRuns         TenderExtraction[]
  status                 ProcurementStatus  @default(DRAFT)
  referenceNumber        String             @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([ownerAuthId, createdAt])
  @@index([status, submissionDeadline])
}

model TenderExtraction {
  id                 String                   @id @default(uuid()) @db.Uuid
  procurementId      String?                  @db.Uuid
  procurement        OrganizationProcurement? @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  tenderId           String?                  @db.Uuid
  tender             Tender?                  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  sourceType         String                   @db.VarChar(32)
  sourceName         String?
  extractor          String                   @db.VarChar(40)
  overallConfidence  Float
  extractedValues    Json
  fieldConfidence    Json
  fieldEvidence      Json
  fieldEvidencePages Json
  missingInformation Json
  reviewStatus       String                   @default("NEEDS_REVIEW") @db.VarChar(24)
  reviewedByAuthId   String?
  reviewedAt         DateTime?
  createdByAuthId    String
  createdAt          DateTime                 @default(now())

  @@index([procurementId, createdAt])
  @@index([tenderId, createdAt])
}

model VerificationRequest {
  id               String             @id @default(uuid()) @db.Uuid
  ownerAuthId      String
  type             VerificationType
  organizationName String
  organizationType String?
  address          String?            @db.Text
  businessName     String?
  contactPerson    String
  email            String
  contactPhone     String?
  registrationNo   String?
  documents        Json               @default("[]")
  status           VerificationStatus @default(PENDING)
  decisionNote     String?            @db.Text
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([ownerAuthId, createdAt])
}

model BusinessProfile {
  id                 String         @id @default(uuid()) @db.Uuid
  ownerAuthId        String         @unique
  businessName       String
  category           String
  location           String
  annualTurnover     Decimal        @db.Decimal(18, 2)
  yearsOfExperience  Int
  certifications     String[]       @default([])
  shareInDirectory   Boolean        @default(false)
  publicContactEmail String?
  contactPerson      String?
  contactEmail       String?
  contactPhone       String?
  description        String?        @db.Text
  productsServices   String[]       @default([])
  previousProjects   String?        @db.Text
  registrationNo     String?
  savedBy            SavedPartner[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([ownerAuthId])
}

model BusinessDocument {
  id          String   @id @default(uuid()) @db.Uuid
  ownerAuthId String
  name        String
  fileName    String
  fileSize    Int
  mimeType    String
  fileData    Bytes?
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerAuthId, createdAt])
}
