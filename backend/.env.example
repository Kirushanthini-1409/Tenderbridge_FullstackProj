NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated exact frontend origins. Leave empty to disable browser CORS.
CORS_ORIGINS=http://127.0.0.1:5175
DATABASE_URL=postgresql://postgres:password@localhost:5432/tenderbridge?schema=public
# Supabase project URL is public configuration. Never put the service role key here.
SUPABASE_URL=https://your-project.supabase.co
# Optional: private legacy HS256 signing secret only. Leave unset for JWKS signing.
SUPABASE_JWT_SECRET=
# Optional: Google Gemini API key for AI tender extraction and summarization
GEMINI_API_KEY=
